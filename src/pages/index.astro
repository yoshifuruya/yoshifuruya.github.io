---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h3>🤚 Hello!</h3>
			<p>
				I'm Yoshi — a tech enthusiast, curious coder, and lifelong tinkerer. I enjoy exploring new technologies, 
				building useful things, and turning ideas into reality. From websites and apps to experimenting with 
				tech stacks and setting up home systems, I'm always up for a new challenge. 
				Whether you're here to check out what I'm building, follow my adventures in tech, or have a project 
				you'd like help with, welcome!
			</p>
			<p>
			</p>
			<p>Explore this site:</p>
			<ul>
				<li>
					<a href="/showcase">Showcase</a> — A collection of projects, experiments, and things I've built or worked on.
				</li>
				<li>
					<a href="/blog">Blog</a> — Thoughts, tutorials, discoveries, and occasional write-ups about technology, coding, and the things I'm learning along the way.
				</li>
				<li>
					<a href="/contact">Contact</a> — Have an idea, need a hand with a tech project, or just want to say hello? Find ways to get in touch here.
				</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
